# Copy to .env.local for local runs (npm run dev). On Vercel, add these under Project Settings > Environment Variables.
# Every connector is optional. Anything left empty falls back to the on-device behaviour the demo already had.

# ---------------------------------------------------------------- MedGemma (Records Reader + trial pre-check)
# Option A: Vertex AI. Deploy MedGemma from Model Garden, then use the endpoint's OpenAI-compatible base URL:
#   https://{DEDICATED_ENDPOINT_DNS}/v1beta1/projects/{PROJECT_ID}/locations/{REGION}/endpoints/{ENDPOINT_ID}
MEDGEMMA_VERTEX_BASE_URL=
# Service-account key with the "Vertex AI User" role. Paste the JSON on one line, or base64-encode it.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B: any OpenAI-compatible server (Hugging Face Inference Endpoint, vLLM, TGI). Base URL ends in /v1.
MEDGEMMA_BASE_URL=
MEDGEMMA_API_KEY=
# Model name the server expects (option B only; Vertex endpoints already fix the model).
# Text-only reading works well with google/medgemma-27b-text-it; google/medgemma-1.5-4b-it is the smaller, newer option.
MEDGEMMA_MODEL=google/medgemma-27b-text-it

# How long to wait for MedGemma (ms) and how many tokens the trial pre-check may use, thinking included.
# The defaults fit Vercel's 60 s function limit. npm run demo, on a laptop, raises them to 90000 and 4500,
# because MedGemma 1.5 4B sometimes needs the room to think through a trial's entry rules.
# MEDGEMMA_TIMEOUT_MS=55000
# PRECHECK_MAX_TOKENS=3600

# Option C: no MedGemma server yet. The Gemini API (Google AI Studio key), called natively with structured output;
# the chat becomes an agent that can look up live trials on ClinicalTrials.gov. It runs in Google's cloud, so only
# use it with the synthetic demo data; the app says so and offers MedGemma on the user's own computer.
# MedGemma (option A or B) is used instead whenever it is set. With both set, Gemini is the chat team's online
# Researcher only: it gets public search words, never the record (lib/researcher.js).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------- Shared demo data (Upstash Redis)
# Add "Upstash for Redis" from the Vercel Marketplace and these are filled in for you.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Same thing under Upstash's own names (either pair works).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Key prefix, so several deployments can share one database.
STORE_PREFIX=tm

# ---------------------------------------------------------------- FHIR R4 records ("Connect a record")
# Test servers only: the demo is not built for real patient data.
# The SMART Health IT sandbox has synthetic patients and needs no token: https://r4.smarthealthit.org
FHIR_BASE_URL=
FHIR_BEARER_TOKEN=
# Patient ID filled in for people trying the demo.
FHIR_DEMO_PATIENT_ID=

# ClinicalTrials.gov (Trial Scout) is public and needs no settings.
